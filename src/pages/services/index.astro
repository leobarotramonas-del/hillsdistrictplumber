---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import CtaBand from '../../components/CtaBand.astro';
import { areas, services, site } from '../../data/site';
---
<BaseLayout title="Hills District Plumbing Services | Antons" description="Explore licensed Hills District plumbing, including blocked drains, hot water, repairs, gas fitting, leak detection and urgent help." canonicalPath="/services/">
  <PageHero eyebrow="Licensed Hills District plumbing" title="Plumbing Services for Homes and Properties" intro="Choose the service that best matches the symptoms. If you are unsure, call and explain what you can see, hear or smell so the team can guide the next step." image="/images/team.webp" imageSmall="/images/team-420.webp" imageAlt="Three Antons plumbers standing together in front of a blue service vehicle" />
  <section class="directory wrap"><div class="service-grid">{services.map((service) => <article class="service-card"><ResponsiveImage src={service.image} small={service.imageSmall} alt={service.alt} width={service.slug === 'blocked-drains' ? 720 : 900} height={service.slug === 'blocked-drains' ? 720 : 900} /><div class="service-card__body"><p class="service-card__label">{service.short}</p><h3>{service.name}</h3><p>{service.intro}</p><a href={`/services/${service.slug}/`}>Explore {service.name}</a></div></article>)}</div></section>
  <section class="content-section expertise-section" aria-labelledby="services-authority-title"><div class="wrap expertise-layout"><div><h2 id="services-authority-title">Why Hills District Properties Choose Our Team</h2><p>The Hills District Plumber is operated by Antons Enterprises Pty Ltd under NSW contractor licence {site.licence}. More than 25 years of trade experience supports practical assessment, clear communication and plumbing work suited to the accessible system.</p></div><div class="expertise-list"><div><h3>Licensed Plumbing and Gas Work</h3><p>Regulated work is completed under the applicable NSW contractor licence.</p></div><div><h3>Specialist Diagnostic Equipment</h3><p>Drain cameras, jetting equipment and leak-detection tools are used where they suit the fault and agreed scope.</p></div><div><h3>Clear, Property-Aware Planning</h3><p>Access, parking, strata requirements and affected services are reviewed before the repair approach is agreed.</p></div></div></div></section>
  <section class="content-section process service-directory-process" aria-labelledby="service-process-title"><div class="wrap"><div class="section-heading"><h2 id="service-process-title">How We Assess and Complete Plumbing Work</h2><p>A consistent process helps move from the reported symptom to an informed repair decision without guessing at the cause.</p></div><div class="process-grid"><article class="process-step"><h3>Understand the Problem</h3><p>We confirm the affected fixtures, property type, access and any immediate safety concern.</p></article><article class="process-step"><h3>Inspect the System</h3><p>The plumber checks the accessible plumbing and uses suitable diagnostic equipment where needed.</p></article><article class="process-step"><h3>Explain the Options</h3><p>The findings, practical repair choices and proposed scope are discussed before work proceeds.</p></article><article class="process-step"><h3>Complete and Check</h3><p>Approved work is completed, the accessible system is checked and the outcome is explained.</p></article></div></div></section>
  <section class="content-section wrap" aria-labelledby="service-locations-title"><div class="section-heading"><h2 id="service-locations-title">Plumbing Services by Hills District Suburb</h2><p>View local property, access and booking information for each priority service area.</p></div><div class="card-list">{areas.map((area) => <a class="route-card" href={`/service-areas/${area.slug}/`}><p class="eyebrow">NSW {area.postcode}</p><h3>{area.name}</h3><p>Explore plumbing services and local guidance for {area.name}.</p></a>)}</div></section>
  <CtaBand />
</BaseLayout>


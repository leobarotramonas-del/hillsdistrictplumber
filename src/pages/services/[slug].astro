---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FaqSection from '../../components/FaqSection.astro';
import CtaBand from '../../components/CtaBand.astro';
import { areas, serviceFaqs, services, site } from '../../data/site';

export function getStaticPaths() { return services.map((service) => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
const path = `/services/${service.slug}/`;
const faqs = serviceFaqs(service.name);
const relatedServices = services.filter((candidate) => candidate.slug !== service.slug).slice(0, 3);
const schema = [
  { '@type': 'Service', '@id': `${site.url}${path}#service`, name: service.name, description: service.description, provider: { '@id': `${site.url}/#business` }, areaServed: [{ '@type': 'AdministrativeArea', name: site.place }, ...areas.map((area) => ({ '@type': 'Place', name: `${area.name} NSW ${area.postcode}`, url: `${site.url}/service-areas/${area.slug}/` }))] },
  { '@type': 'BreadcrumbList', '@id': `${site.url}${path}#breadcrumb`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` }, { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services/` }, { '@type': 'ListItem', position: 3, name: service.name, item: `${site.url}${path}` }] },
  { '@type': 'FAQPage', '@id': `${site.url}${path}#faq`, mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
];
---
<BaseLayout title={service.title} description={service.description} canonicalPath={path} schema={schema} image={service.image} imageAlt={service.alt}>
  <PageHero eyebrow="Hills District plumbing service" title={service.name} intro={service.intro} image={service.image} imageSmall={service.imageSmall} imageAlt={service.alt} />
  <section class="content-section wrap service-overview"><div class="content-grid"><div class="detail-copy"><h2>What Is {service.name}?</h2><p>{service.overview}</p><p>Across the Hills District, the Antons team assesses the visible symptoms, accessible plumbing and property conditions before recommending work.</p></div><div class="service-scope"><h3>{service.name} Services</h3><ul class="check-list">{service.details.map((item) => <li>{item}</li>)}</ul></div></div></section>
  <section class="content-section service-signs"><div class="wrap"><div class="section-heading"><h2>Signs You May Need {service.name}</h2><p>These symptoms can indicate a plumbing fault worth assessing. The cause cannot be confirmed from a symptom alone, so the next step depends on the affected fixtures, access and condition of the system.</p></div><div class="signal-list">{service.signs.map((item) => <p>{item}</p>)}</div></div></section>
  <section class="content-section expertise-section"><div class="wrap expertise-layout"><div><h2>{service.name} Expertise Across the Hills District</h2><p>Regulated work is completed by the Antons team operating under NSW contractor licence {site.licence}. The focus is on careful diagnosis, an explained scope and work suited to the accessible plumbing.</p></div><div class="expertise-list">{service.expertise.map((item) => <div><h3>{item}</h3><p>Applied where it is appropriate to the fault, property and agreed scope of work.</p></div>)}</div></div></section>
  <section class="content-section service-areas-section"><div class="wrap"><div class="section-heading"><h2>{service.name} Across Hills District Suburbs</h2><p>We take {service.name.toLowerCase()} enquiries from these primary Hills District service areas. Call with the full property address and a description of the problem so coverage and current availability can be confirmed.</p></div><div class="service-area-links">{areas.map((area) => <a href={`/service-areas/${area.slug}/`} aria-label={`${service.name} service information for ${area.name}`}><span>{area.name} NSW {area.postcode}</span><h3>{service.name} in {area.name}</h3><p>View local service, property access and booking information for {area.name}.</p></a>)}</div></div></section>
  <section class="content-section process service-process"><div class="wrap"><div class="section-heading"><h2>How We Diagnose and Resolve {service.name} Problems</h2><p>A consistent process helps the plumber move from the reported symptom to an informed repair decision.</p></div><div class="process-grid"><article class="process-step"><h3>Understand the Symptoms</h3><p>We confirm the affected fixtures, when the issue began, the property type and any immediate safety concern.</p></article><article class="process-step"><h3>Inspect the Accessible System</h3><p>The plumber reviews the visible condition, relevant connections and access before narrowing the likely cause.</p></article><article class="process-step"><h3>Explain the Repair Options</h3><p>The findings, practical options and proposed scope are discussed before agreed work proceeds.</p></article><article class="process-step"><h3>Complete and Check the Work</h3><p>The selected repair is completed and the accessible system is checked before the outcome is explained.</p></article></div></div></section>
  <section class="content-section wrap" aria-labelledby="related-services-title"><div class="section-heading"><h2 id="related-services-title">Related Hills District Plumbing Services</h2><p>Plumbing symptoms can overlap. Explore these related services to find the page that best matches what is happening at your property.</p></div><div class="card-list nearby-list">{relatedServices.map((related) => <a class="route-card" href={`/services/${related.slug}/`}><p class="eyebrow">{related.short}</p><h3>{related.name}</h3><p>{related.intro}</p></a>)}</div></section>
  {service.slug === 'gas-fitting' && <section class="content-section wrap"><div class="detail-copy"><h2>Planning Gas Work Beyond the Hills District?</h2><p>For information about the team's wider Sydney plumbing and gas services, visit <a href="https://antonsplumbingandgas.com.au/">Antons Plumbing &amp; Gas</a>. Mention the property address, appliance and planned work when enquiring so the team can confirm the appropriate service and availability.</p></div></section>}
  {service.slug === 'plumbing-repairs' && <section class="content-section wrap"><div class="detail-copy"><h2>When a Repair Is Part of a Renovation</h2><p>A leaking fixture may need a straightforward repair. If you are also planning a bathroom or kitchen redesign, explore <a href="https://antonsrenovations.com.au/">Antons Renovations</a> for the broader project. Explain any proposed fixture relocations and layout changes before plumbing work is scoped, so the repair and renovation plans can be considered together.</p></div></section>}
  <FaqSection faqs={faqs} title={`${service.name} Questions`} />
  <CtaBand title={`Ask About ${service.name}`} />
</BaseLayout>


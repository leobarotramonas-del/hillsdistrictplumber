---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="Privacy Policy | Hills District Plumber" description="Read the privacy policy for The Hills District Plumber by Antons, including how contact details and service enquiry information may be handled." canonicalPath="/privacy/">
  <article class="legal"><p class="eyebrow">Website information</p><h1>Privacy Policy</h1><p>Last updated 6 October 2026.</p><p>This website is operated by {site.operator}. We respect the privacy of people who contact us about plumbing services.</p><h2>Information You Provide</h2><p>When you call or otherwise contact the business, you may provide your name, phone number, service address, property access information, photos and details about the plumbing issue.</p><h2>How Information Is Used</h2><p>Information may be used to respond to the enquiry, assess service coverage, arrange work, communicate about the job and meet legal or record-keeping obligations.</p><h2>Website Services</h2><p>This website may link to third-party services such as Google reviews and maps. Those services operate under their own privacy terms.</p><h2>Questions</h2><p>Call <a href={site.phoneHref}>{site.phoneDisplay}</a> with privacy questions related to a service enquiry.</p></article>
</BaseLayout>


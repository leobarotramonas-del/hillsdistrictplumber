---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import AreaMap from '../../components/AreaMap.astro';
import FaqSection from '../../components/FaqSection.astro';
import CtaBand from '../../components/CtaBand.astro';
import { areas, services, site } from '../../data/site';

export function getStaticPaths() { return areas.map((area) => ({ params: { slug: area.slug }, props: { area } })); }
const { area } = Astro.props;
const path = `/service-areas/${area.slug}/`;
const neighbours = area.neighbours
  .map((slug) => areas.find((candidate) => candidate.slug === slug))
  .filter((candidate): candidate is NonNullable<typeof candidate> => Boolean(candidate));
const schema = [
  { '@type': 'BreadcrumbList', '@id': `${site.url}${path}#breadcrumb`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` }, { '@type': 'ListItem', position: 2, name: 'Service Areas', item: `${site.url}/service-areas/` }, { '@type': 'ListItem', position: 3, name: area.name, item: `${site.url}${path}` }] },
  { '@type': 'FAQPage', '@id': `${site.url}${path}#faq`, mainEntity: area.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
];
---
<BaseLayout title={area.title} description={area.description} canonicalPath={path} schema={schema} image={area.image} imageAlt={area.alt}>
  <PageHero eyebrow={`${area.name} NSW ${area.postcode}`} title={`Licensed Plumber in ${area.name}`} intro={area.intro} image={area.image} imageSmall={area.imageSmall} imageAlt={area.alt} />
  <section class="content-section wrap"><div class="detail-copy"><p class="eyebrow">Property and access context</p><h2>Useful Details Before the Visit</h2><p>{area.context}</p><p>Ask the caller for the full street address so coverage and current availability can be confirmed. We do not claim every address can be attended or promise an arrival time before those details are reviewed.</p><div class="area-facts"><div><strong>Suburb</strong><span>{area.name}</span></div><div><strong>Postcode</strong><span>{area.postcode}</span></div><div><strong>Licence</strong><span>{site.licence}</span></div></div></div></section>
  <section class="content-section area-services"><div class="wrap"><div class="section-heading"><h2>Plumbing Services in {area.name}</h2><p>Our licensed plumbing services in {area.name} cover urgent faults, blocked drains, hot-water systems, leaks, gas fitting and everyday household repairs. Select a service to understand the symptoms, assessment and available repair approach.</p></div><div class="area-service-list">{services.map((service) => <a href={`/services/${service.slug}/`}><span>{service.short}</span><h3>{service.name}</h3><p>{service.description}</p></a>)}</div></div></section>
  <section class="content-section expertise-section"><div class="wrap expertise-layout"><div><h2>Practical Plumbing Help for {area.name} Properties</h2><p>From blocked drains and leaking fixtures to hot-water faults, gas fitting and general repairs, our service is shaped around the plumbing problem and the property. Customers in {area.name} can expect useful questions, careful assessment and a clear explanation of the next practical step.</p></div><div class="expertise-list"><div><h3>Help Across Common Plumbing Problems</h3><p>We assist with urgent faults, blocked drains, leaks, hot-water systems, gas fitting and everyday plumbing repairs.</p></div><div><h3>Planning Suited to the Property</h3><p>Property type, parking, strata requirements, side access and shared services are considered when planning the visit.</p></div><div><h3>Clear Advice Before Work Begins</h3><p>We explain what can be assessed, the available repair options and the agreed scope before work proceeds.</p></div></div></div></section>
  <section class="content-section process area-process"><div class="wrap"><div class="section-heading"><h2>How We Assess and Repair Plumbing Problems in {area.name}</h2><p>From the first call to the completed work, the process is designed to gather useful information, inspect the accessible plumbing and agree on a practical next step.</p></div><div class="process-grid"><article class="process-step"><h3>Confirm the Address and Fault</h3><p>Share the {area.name} address, property type, affected fixtures and when the plumbing problem began.</p></article><article class="process-step"><h3>Plan Access and Equipment</h3><p>We review parking, strata requirements, pets, side access and equipment needs where relevant.</p></article><article class="process-step"><h3>Inspect and Explain the Cause</h3><p>The plumber assesses the accessible system and explains the likely cause and repair options.</p></article><article class="process-step"><h3>Complete the Agreed Repair</h3><p>Approved work proceeds, the accessible system is checked and the outcome is explained clearly.</p></article></div></div></section>
  <section class="content-section wrap area-location"><div class="content-grid"><div><h2>Plumbing Coverage Around {area.name}</h2><p>{area.context}</p><p>Use the location guide to identify the suburb, then call with the complete street address to confirm current service availability.</p></div><AreaMap name={area.name} postcode={area.postcode} /></div></section>
  <section class="content-section wrap"><h2>Nearby Hills District Service Areas</h2><div class="card-list nearby-list">{neighbours.map((neighbour) => <a class="route-card" href={`/service-areas/${neighbour.slug}/`}><h3>{neighbour.name} {neighbour.postcode}</h3><p>View local plumbing services, property guidance and answers for {neighbour.name}.</p></a>)}</div></section>
  <FaqSection faqs={area.faqs} title={`${area.name} Plumbing Questions`} />
  <CtaBand title={`Need a Plumber in ${area.name}?`} />
</BaseLayout>


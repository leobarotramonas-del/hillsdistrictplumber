---
import type { Faq } from '../data/site';
interface Props { faqs: Faq[]; title?: string }
const { faqs, title = 'Questions Answered Clearly' } = Astro.props;
---
<section class="faq-section wrap" aria-labelledby="faq-title"><div class="section-heading"><h2 id="faq-title">{title}</h2></div><div class="faq-list">{faqs.map((faq, index) => <details open={index === 0}><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></section>

